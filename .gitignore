*.egg-info/
*.py[cod]
.pytest_cache/
.venv/
__pycache__/
build/
dist/

# Connection configs carry a PAT and must never be committed. Scoped to the
# filenames the docs tell you to create -- a blanket `*.json` also silently
# ignored this repo's own recipes/api_quickstart/*.json payloads.
connection.json
conn.json
*-config.json
config.json

# The RL and distillation examples write the jobs each run built here; these are
# local records regenerated per run.
recipes/rl_quickstart/configs/
recipes/distillation/configs/
