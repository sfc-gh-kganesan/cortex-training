{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "zai-org/GLM-5.3-Flash",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 4,
        "max_seq_len": 65536,
        "train_batch_size": 1,
        "gradient_clipping": 1.0,
        "model_provider": "arctic",
        "attn_implementation": "sparse_mla",
        "cuda_allocator_conf": "expandable_segments:True",
        "activation_checkpointing": true,
        "sp_size": 4,
        "ep_size": 4,
        "ep_group_layout": "auto",
        "mb_spec": {
          "max_tokens_per_mb": 65536
        },
        "ac_config": {
          "mode": "full",
          "freq": 1,
          "router_replay_recompute": true,
          "offload_config": {
            "enabled": true,
            "keep_last_n": 1,
            "use_streams": true,
            "pin_memory_enabled": true,
            "pin_memory_max_size_gib": "auto",
            "pin_memory_bucket_size_mib": 64
          }
        },
        "tiled_mlp_token_chunk_size": 1024,
        "step_peak_memory_log": true,
        "prime_rl": {
          "ep_comm_backend": "deepep",
          "deepep_token_chunk_size": 8192,
          "fused_cross_entropy": false
        },
        "optimizer": {
          "name": "AdamW",
          "lr": 0.0001,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "train_batch_size": 1,
          "train_micro_batch_size_per_gpu": 1,
          "gradient_accumulation_steps": 1,
          "zero_optimization": {
            "stage": 2,
            "offload_optimizer": {
              "device": "cpu",
              "pin_memory": false
            }
          },
          "bf16": {
            "enabled": true,
            "bf16_master_weights_and_grads": true,
            "bf16_optimizer_states": true
          }
        },
        "peft_config": {
          "peft_type": "Lora",
          "r": 32,
          "lora_alpha": 32,
          "lora_dropout": 0.0,
          "bias": "none",
          "target_modules": [
            "q_a_proj",
            "q_b_proj",
            "kv_a_proj_with_mqa",
            "o_proj"
          ]
        }
      }
    }
  ]
}
