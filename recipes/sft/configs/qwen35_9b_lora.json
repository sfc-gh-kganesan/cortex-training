{
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "Qwen/Qwen3.5-9B",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 8,
        "max_seq_len": 65536,
        "train_batch_size": 8,
        "gradient_clipping": 1.0,
        "model_provider": "huggingface",
        "attn_implementation": "flash_attention_3",
        "activation_checkpointing": true,
        "fused_lm_head_token_chunk_size": 8192,
        "optimizer": {
          "name": "AdamW",
          "lr": 1e-04,
          "weight_decay": 0.0,
          "betas": [0.9, 0.999],
          "eps": 1e-08
        },
        "ds_config": {
          "zero_optimization": {
            "stage": 2
          },
          "bf16": {
            "enabled": true
          }
        },
        "peft_config": {
          "peft_type": "Lora",
          "r": 32,
          "lora_alpha": 32,
          "lora_dropout": 0.0,
          "bias": "none",
          "target_modules": [
            "q_proj",
            "k_proj",
            "v_proj",
            "o_proj",
            "gate_proj",
            "up_proj",
            "down_proj"
          ]
        }
      }
    }
  ]
}
